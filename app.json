{
  "expo": {
    "name": "SignPure",
    "slug": "signpure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "signpure",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altixcode.signpure",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SignPure uses Face ID / Touch ID to secure your signature vault and confidential documents.",
        "CFBundleLocalizations": [
          "en",
          "es",
          "fr",
          "de",
          "ru",
          "zh",
          "ja",
          "pt",
          "ko",
          "it",
          "tr",
          "ar",
          "fa",
          "el"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "com.altixcode.signpure",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#030712",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withIOSSceneLifecycle.js"
    ]
  }
}
